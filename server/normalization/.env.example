# Normalization Service
PORT=8085
WS_PORT=8086
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=realtime_ktzh
DB_USER=postgres
DB_PASSWORD=postgres
